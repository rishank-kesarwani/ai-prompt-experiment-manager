# ==============================================================================
# AI Prompt Experiment & Release Manager - Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Default Tenant / Workspace Scope for UI sessions
NEXT_PUBLIC_DEFAULT_TENANT_ID=tenant-enterprise-default

# Default Application Scope
NEXT_PUBLIC_DEFAULT_APP_ID=customer-support-agent

# Enable Public Demo Mode controls in client navigation
NEXT_PUBLIC_DEMO_MODE=true
