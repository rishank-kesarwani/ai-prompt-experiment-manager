# ==============================================================================
# AI Prompt Experiment & Release Manager - Backend Environment Configuration
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
PUBLIC_ACCESS_ENABLED=true
CORS_ORIGIN=*

# Tenant and Auth Configuration
DEFAULT_TENANT_ID=tenant-enterprise-default
JWT_SECRET=dev-jwt-secret-replace-in-production
API_KEY=dev-service-api-key-replace-in-production

# Shared Service Integrations (Environment-configured, optional at startup)
AI_PLATFORM_URL=http://localhost:4000
AI_PLATFORM_API_KEY=dev-ai-platform-api-key
AI_PLATFORM_TIMEOUT_MS=5000

MODEL_REGRESSION_SERVICE_URL=http://localhost:4001
MODEL_REGRESSION_SERVICE_API_KEY=dev-model-regression-api-key
MODEL_REGRESSION_TIMEOUT_MS=5000
MODEL_REGRESSION_FAIL_CLOSED=true

NOTIFICATION_SERVICE_URL=http://localhost:4002
NOTIFICATION_SERVICE_API_KEY=dev-notification-api-key
NOTIFICATION_TIMEOUT_MS=3000

# Experimentation & Rollout Defaults
DEFAULT_BUCKET_COUNT=100
MIN_SAMPLE_SIZE_FOR_SIGNIFICANCE=30
CONFIDENCE_LEVEL=0.95
